[Unit]
Description=opencode-atme-proxy Feishu bot
After=network-online.target opencode-serve.service
Wants=network-online.target opencode-serve.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/home/renyuan/opencode-atme-proxy.git
Environment=HOME=/root
Environment=PATH=/root/.nvm/versions/node/v24.22.1/bin:/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env atme-proxy start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
