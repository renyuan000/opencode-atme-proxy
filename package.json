{
  "name": "opencode-atme-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic, approval-gated chat task bot that identifies tasks, analyzes them, and hands approved work to OpenCode.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "probe": "tsx src/scripts/probe-history.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "tsx src/scripts/demo.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@opencode-ai/sdk": "^1.19.5",
    "dotenv": "^16.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.19.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  }
}
